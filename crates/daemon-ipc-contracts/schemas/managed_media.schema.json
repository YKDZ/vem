{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagedMediaDescriptor",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "reference": {
      "type": "string",
      "pattern": "^\\/api\\/media-assets\\/[0-9a-f-]+\\/content$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "byteSize": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "purpose": {
      "type": "string",
      "enum": ["product_display_image", "try_on_garment"]
    },
    "revision": {
      "type": "object",
      "properties": {
        "catalogRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assetRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["catalogRevision"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "reference",
    "digest",
    "contentType",
    "byteSize",
    "purpose",
    "revision"
  ],
  "additionalProperties": false
}
