{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagedMediaContract",
  "type": "object",
  "properties": {
    "reconcileRequest": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "interests": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "reference": {
                "type": "string",
                "pattern": "^\\/api\\/media-assets\\/[0-9a-f-]+\\/content$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "contentType": {
                "type": "string",
                "enum": ["image/png", "image/jpeg", "image/webp"]
              },
              "byteSize": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "purpose": {
                "type": "string",
                "enum": ["product_display_image", "try_on_garment"]
              },
              "revision": {
                "type": "object",
                "properties": {
                  "catalogRevision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "assetRevision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": ["catalogRevision"],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "reference",
              "digest",
              "contentType",
              "byteSize",
              "purpose",
              "revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["generation", "interests"],
      "additionalProperties": false
    },
    "reconcileReceipt": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accepted": {
          "type": "boolean",
          "const": true
        },
        "interestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "assets": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "descriptor": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "reference": {
                        "type": "string",
                        "pattern": "^\\/api\\/media-assets\\/[0-9a-f-]+\\/content$"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "contentType": {
                        "type": "string",
                        "enum": ["image/png", "image/jpeg", "image/webp"]
                      },
                      "byteSize": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "purpose": {
                        "type": "string",
                        "enum": ["product_display_image", "try_on_garment"]
                      },
                      "revision": {
                        "type": "object",
                        "properties": {
                          "catalogRevision": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "assetRevision": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        },
                        "required": ["catalogRevision"],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "id",
                      "reference",
                      "digest",
                      "contentType",
                      "byteSize",
                      "purpose",
                      "revision"
                    ],
                    "additionalProperties": false
                  },
                  "readiness": {
                    "type": "string",
                    "enum": ["ready", "warming", "unavailable"]
                  },
                  "readyUrl": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^https?:\\/\\/(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::(?:[1-9][0-9]{0,4}))?\\/media\\/sha256:[0-9a-f]{64}\\?grant=[A-Za-z0-9._~-]{16,128}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "diagnostic": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "diagnosticReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "descriptor_invalid",
                          "cache_budget_exceeded",
                          "manifest_persistence_failed",
                          "download_failed",
                          "byte_size_mismatch",
                          "content_type_mismatch",
                          "media_facts_invalid",
                          "digest_mismatch",
                          "published_media_corrupt",
                          "defensive_read_failed"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "descriptor",
                  "readiness",
                  "readyUrl",
                  "diagnostic"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["generation", "assets"],
          "additionalProperties": false
        }
      },
      "required": ["generation", "accepted", "interestCount", "snapshot"],
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "properties": {
        "descriptor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "reference": {
              "type": "string",
              "pattern": "^\\/api\\/media-assets\\/[0-9a-f-]+\\/content$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "contentType": {
              "type": "string",
              "enum": ["image/png", "image/jpeg", "image/webp"]
            },
            "byteSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "purpose": {
              "type": "string",
              "enum": ["product_display_image", "try_on_garment"]
            },
            "revision": {
              "type": "object",
              "properties": {
                "catalogRevision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "assetRevision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": ["catalogRevision"],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "reference",
            "digest",
            "contentType",
            "byteSize",
            "purpose",
            "revision"
          ],
          "additionalProperties": false
        },
        "readiness": {
          "type": "string",
          "enum": ["ready", "warming", "unavailable"]
        },
        "readyUrl": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https?:\\/\\/(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::(?:[1-9][0-9]{0,4}))?\\/media\\/sha256:[0-9a-f]{64}\\?grant=[A-Za-z0-9._~-]{16,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnosticReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "descriptor_invalid",
                "cache_budget_exceeded",
                "manifest_persistence_failed",
                "download_failed",
                "byte_size_mismatch",
                "content_type_mismatch",
                "media_facts_invalid",
                "digest_mismatch",
                "published_media_corrupt",
                "defensive_read_failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["descriptor", "readiness", "readyUrl", "diagnostic"],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assets": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "descriptor": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "reference": {
                    "type": "string",
                    "pattern": "^\\/api\\/media-assets\\/[0-9a-f-]+\\/content$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "contentType": {
                    "type": "string",
                    "enum": ["image/png", "image/jpeg", "image/webp"]
                  },
                  "byteSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "purpose": {
                    "type": "string",
                    "enum": ["product_display_image", "try_on_garment"]
                  },
                  "revision": {
                    "type": "object",
                    "properties": {
                      "catalogRevision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "assetRevision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": ["catalogRevision"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "reference",
                  "digest",
                  "contentType",
                  "byteSize",
                  "purpose",
                  "revision"
                ],
                "additionalProperties": false
              },
              "readiness": {
                "type": "string",
                "enum": ["ready", "warming", "unavailable"]
              },
              "readyUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^https?:\\/\\/(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::(?:[1-9][0-9]{0,4}))?\\/media\\/sha256:[0-9a-f]{64}\\?grant=[A-Za-z0-9._~-]{16,128}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "diagnostic": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "diagnosticReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "descriptor_invalid",
                      "cache_budget_exceeded",
                      "manifest_persistence_failed",
                      "download_failed",
                      "byte_size_mismatch",
                      "content_type_mismatch",
                      "media_facts_invalid",
                      "digest_mismatch",
                      "published_media_corrupt",
                      "defensive_read_failed"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["descriptor", "readiness", "readyUrl", "diagnostic"],
            "additionalProperties": false
          }
        }
      },
      "required": ["generation", "assets"],
      "additionalProperties": false
    }
  },
  "required": [
    "reconcileRequest",
    "reconcileReceipt",
    "projection",
    "snapshot"
  ],
  "additionalProperties": false
}
